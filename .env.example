# Xero Custom Connection credentials
# Get these from: https://developer.xero.com/
# (Create a Custom Connection app — no browser login required)

XERO_CLIENT_ID=your-custom-connection-client-id
XERO_CLIENT_SECRET=your-custom-connection-client-secret

# Optional: if you have multiple Xero organisations, specify which one to use
# XERO_TENANT_ID=your-tenant-id

# Optional: override the default DuckDB output path
# XERO_DUCKDB_PATH=./data/xero_accounts.duckdb

# Optional: API page timeout in seconds (default: 60)
# XERO_PAGE_TIMEOUT=60

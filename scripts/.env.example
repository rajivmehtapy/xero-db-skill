# Xero Custom Connection credentials
# Get these from: https://developer.xero.com/
# Create a Custom Connection app, copy Client ID and Client Secret below.

XERO_CLIENT_ID=your-client-id-here
XERO_CLIENT_SECRET=your-client-secret-here

# Optional: specify a tenant if you have multiple Xero organisations
# XERO_TENANT_ID=your-tenant-id-here

# Optional: API page timeout in seconds (default: 60)
# XERO_PAGE_TIMEOUT=60
